{
  "name": "owd-sync",
  "version": "0.1.6",
  "private": true,
  "description": "The OWD Sync companion plugin for Obsidian.",
  "license": "Apache-2.0 AND 0BSD",
  "type": "module",
  "main": "main.js",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production && node scripts/guard-production-bundles.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard:bundles": "node scripts/guard-production-bundles.mjs",
    "lint": "oxlint --deny-warnings --ignore-pattern 'vendor/**' .",
    "package": "pnpm build && node scripts/package-release.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "fast-diff": "1.3.0",
    "fflate": "0.8.2",
    "js-yaml": "4.3.0",
    "partyserver": "0.3.2",
    "y-codemirror.next": "0.3.5",
    "y-indexeddb": "9.0.12",
    "y-partyserver": "2.1.2",
    "yjs": "13.6.29"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "26.1.1",
    "esbuild": "0.25.5",
    "obsidian": "1.13.1",
    "oxlint": "1.74.0",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "tslib": "2.4.0"
  }
}
